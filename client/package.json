{
  "name": "k8s-lsp-client",
  "displayName": "Kubernetes LSP Client",
  "description": "VS Code Client for Kubernetes LSP",
  "version": "0.1.6",
  "publisher": "k8s-lsp",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.82.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ariyn/k8s-lsp",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/Ariyn/k8s-lsp/issues"
  },
  "homepage": "https://github.com/Ariyn/k8s-lsp",
  "keywords": [
    "kubernetes",
    "yaml",
    "lsp",
    "crd"
  ],
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "k8sLsp.openEmbeddedFile",
        "title": "Kubernetes LSP: Open Embedded File"
      },
      {
        "command": "k8sLsp.findEmbeddedFileUsages",
        "title": "Kubernetes LSP: Find Embedded File Usages"
      },
      {
        "command": "k8sLsp.showSubPathTargets",
        "title": "Kubernetes LSP: Show subPath Targets"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "aliases": [
          "YAML"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Kubernetes LSP",
      "properties": {
        "k8sLsp.crdSources": {
          "scope": "resource",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "List of URLs to Kubernetes CRD YAML manifests to download and index (e.g. Traefik CRDs)."
        },
        "k8sLsp.serverPath": {
          "scope": "machine",
          "type": "string",
          "default": "k8s-lsp",
          "description": "Path to the k8s-lsp executable"
        },
        "k8sLsp.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rimraf out",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^2.26.0",
    "rimraf": "^5.0.5",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}